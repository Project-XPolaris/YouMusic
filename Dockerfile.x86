FROM --platform=linux/amd64 node:18.20.4 AS builder
WORKDIR /app

# 安装 pnpm 并安装依赖
RUN npm i -g pnpm@10.15.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 复制源码并构建
COPY . .
RUN pnpm build

FROM --platform=linux/amd64 node:18.20.4 AS runtime
WORKDIR /app

# 安装 pnpm，仅复制运行所需文件
RUN npm i -g pnpm@10.15.0
COPY --from=builder /app/package.json /app/pnpm-lock.yaml ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/data ./data
COPY --from=builder /app/nest-cli.json ./
COPY --from=builder /app/tsconfig.build.json ./
COPY --from=builder /app/ulist.json ./
COPY --from=builder /app/youplus.json ./

ENV NODE_ENV=production

# 生产依赖安装
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 make g++ libvips; \
    rm -rf /var/lib/apt/lists/*; \
    pnpm install --prod --frozen-lockfile; \
    pnpm rebuild sharp --verbose || true

EXPOSE 3001
CMD ["pnpm", "start:prod"]


